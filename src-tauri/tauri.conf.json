{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "sql-analyzer",
  "version": "0.1.0",
  "identifier": "com.nachernev.sql-analyzer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "https://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SQL Analyzer",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http: https: data: blob: asset:; connect-src 'self' http: https: ws: wss: http://localhost:8080 http://192.168.0.17:9000;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
  
}